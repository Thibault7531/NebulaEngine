{
  "version": 6,
  "configurePresets": [
    {
      "name": "Debug-Windows-AMD64",
      "displayName": "Windows x86 - Debug",
      "description": "Windows Desktop Compiling",
      "generator": "Visual Studio 17 2022",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
